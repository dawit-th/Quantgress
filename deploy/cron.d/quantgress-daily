# Quantgress — daily cron jobs
# Install: sudo cp quantgress-daily /etc/cron.d/quantgress-daily && sudo chmod 644 /etc/cron.d/quantgress-daily
# run_job.py runs the group's scripts back to back (DuckDB allows one writer, so
# the old 15-min stagger crashed any job that started while a slow one held the
# lock), then refreshes the API snapshot. Scripts: `python run_job.py --list`.
#
# minute hour dom month dow  user     command
     0    6    *    *    *   ubuntu   cd /home/ubuntu/quantgress && venv/bin/python run_job.py daily >> logs/run_job.log 2>&1
