# Quantgress — annual cron jobs
# Install: sudo cp quantgress-annual /etc/cron.d/quantgress-annual && sudo chmod 644 /etc/cron.d/quantgress-annual
# Election-cycle / annual-filing sources. Run early January, after year-end filings settle.
#
# minute hour dom month dow  user     command
     0    9    2    1    *   ubuntu   cd /home/ubuntu/quantgress && venv/bin/python run_job.py annual-jan >> logs/run_job.log 2>&1
# House annual reports are due May 15 with extensions to mid-August, so the
# prior year's coverage is only complete in September -- a January run would
# find an empty index for it.
     0    9    2    9    *   ubuntu   cd /home/ubuntu/quantgress && venv/bin/python run_job.py annual-sep >> logs/run_job.log 2>&1
